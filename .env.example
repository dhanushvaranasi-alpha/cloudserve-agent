# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it (already done in this repo).

GROQ_API_KEY=your_key_here
MODEL_NAME=openai/gpt-oss-120b
CLASSIFIER_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DECISION_LOG_PATH=./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

# Optional: LangSmith tracing (this branch only -- src/pipeline.py is a
# LangGraph graph, so tracing needs no code changes, just these three
# lines). Get a free API key at smith.langchain.com, Settings > API Keys.
# Leave LANGSMITH_TRACING unset/false and nothing changes: no external
# call is made, and no test depends on this. See docs/architecture.md §7.
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=cloudserve-support
